# Clave gratuita de TMDB (https://www.themoviedb.org/settings/api).
# Sirve tanto la "API Key" como el "API Read Access Token".
# Sin ella la app usa TVmaze: funciona, pero en inglés y con una sola captura.
TMDB_API_KEY=

# Idioma de títulos y sinopsis: es-ES (España) o es-MX (Latinoamérica).
SIMPSONS_LANG=es-ES
